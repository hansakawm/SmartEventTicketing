@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<h2>Sign In</h2>
<p class="text-muted">Welcome back. Sign in to access your account.</p>

<div class="form-container mt-2">
    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="form-group">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
        </div>

        <div class="action-buttons mt-3">
            <button id="login-submit" type="submit" class="btn btn-success">Login</button>
        </div>

        <p class="mt-3 text-muted">
            Don't have an account?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register here</a>
        </p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
