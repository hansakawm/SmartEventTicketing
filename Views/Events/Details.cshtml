@model SmartEventTicketing.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h2>Event Details</h2>

<div class="card mt-2">
    <div class="card-header">
        <h3 class="card-title">@Model.EventName</h3>
    </div>

    <p><strong>Category:</strong> @Model.Category?.CategoryName</p>
    <p><strong>Venue:</strong> @Model.Venue</p>
    <p><strong>Event Date:</strong> @Model.EventDate.ToString("dd MMM yyyy, h:mm tt")</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Total Seats:</strong> @Model.TotalSeats</p>
    <p><strong>Available Seats:</strong> @Model.AvailableSeats</p>
    <p><strong>Standard Price:</strong> LKR @Model.StandardPrice.ToString("N2")</p>
    <p><strong>VIP Price:</strong> LKR @Model.VIPPrice.ToString("N2")</p>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <p><strong>Image URL:</strong> @Model.ImageUrl</p>
    }

    <div class="action-buttons mt-2">
        <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-outline">Back to List</a>
    </div>
</div>
