@model SmartEventTicketing.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h2>Delete Event</h2>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this event?</strong>
    This action cannot be undone.
</div>

<div class="card">
    <h3>@Model.EventName</h3>
    <p><strong>Category:</strong> @Model.Category?.CategoryName</p>
    <p><strong>Venue:</strong> @Model.Venue</p>
    <p><strong>Event Date:</strong> @Model.EventDate.ToString("dd MMM yyyy, h:mm tt")</p>
    <p><strong>Available Seats:</strong> @Model.AvailableSeats / @Model.TotalSeats</p>

    <form asp-action="Delete" class="mt-2">
        <input type="hidden" asp-for="EventId" />
        <div class="action-buttons">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
