@model IEnumerable<SmartEventTicketing.Models.Event>
@{
    ViewData["Title"] = "Browse Events";
    var categories = ViewBag.Categories as List<SmartEventTicketing.Models.EventCategory> ?? new List<SmartEventTicketing.Models.EventCategory>();
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="section-heading">
    <h2>Browse Events</h2>
</div>

<!-- Search Bar -->
<div class="search-bar">
    <form asp-action="Browse" method="get">
        <div class="search-row">
            <div class="form-group">
                <label>Search by Name or Venue</label>
                <input type="text" name="searchString" value="@ViewBag.SearchString" placeholder="e.g. Symphony, Galle Face..." />
            </div>

            <div class="form-group">
                <label>Category</label>
                <select name="categoryId">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        if (ViewBag.CategoryId != null && (int)ViewBag.CategoryId == cat.CategoryId)
                        {
                            <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                        }
                        else
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label>From Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" />
            </div>

            <div class="form-group">
                <label>To Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" />
            </div>

            @if (isAuthenticated)
            {
                <div class="form-group">
                    <label>Max Price (LKR)</label>
                    <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" step="100" min="0" />
                </div>
            }

            <div class="form-group">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>

        <p class="text-muted mt-1 mb-1">
            <a asp-action="Browse">Clear filters</a>
        </p>
    </form>
</div>

<!-- Results -->
@if (!Model.Any())
{
    <div class="alert alert-info">No events match your search. Try adjusting your filters.</div>
}
else
{
    <p class="text-muted mb-2">@Model.Count() event(s) found.</p>

    <div class="event-grid">
        @foreach (var item in Model)
        {
            <article class="event-card">
                <div class="event-card-image">
                    @item.EventName
                </div>
                <div class="event-card-body">
                    <span class="event-category">@item.Category?.CategoryName</span>
                    <h3 class="event-name">@item.EventName</h3>
                    <p class="event-meta"><strong>Venue:</strong> @item.Venue</p>
                    <p class="event-meta"><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy, h:mm tt")</p>

                    @if (isAuthenticated)
                    {
                        <p class="event-meta">
                            <strong>Seats:</strong> @item.AvailableSeats / @item.TotalSeats available
                        </p>
                        <p class="event-price">
                            Standard: LKR @item.StandardPrice.ToString("N2") &middot;
                            VIP: LKR @item.VIPPrice.ToString("N2")
                        </p>
                    }
                    else
                    {
                        <p class="event-meta">
                            @if (item.AvailableSeats > 0)
                            {
                                <span class="availability-tag availability-available">Available</span>
                            }
                            else
                            {
                                <span class="availability-tag availability-full">Full</span>
                            }
                        </p>
                        <p class="event-meta text-muted">Login to see pricing and book tickets.</p>
                    }
                </div>
                <div class="event-card-footer">
                    <a asp-action="PublicDetails" asp-route-id="@item.EventId" class="btn btn-primary btn-sm">View Details</a>
                </div>
            </article>
        }
    </div>
}
