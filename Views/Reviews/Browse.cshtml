@model IEnumerable<SmartEventTicketing.Models.Review>
@{
    ViewData["Title"] = "Reviews";
}

<div class="section-heading">
    <h2>All Reviews</h2>
</div>

<div class="search-bar">
    <form asp-action="Browse" method="get">
        <div class="search-row">
            <div class="form-group">
                <label>Search by Event Name</label>
                <input type="text" name="searchString" value="@ViewBag.SearchString" placeholder="e.g. Symphony, Marathon..." />
            </div>

            <div class="form-group">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>

        <p class="text-muted mt-1 mb-1">
            <a asp-action="Browse">Clear search</a>
        </p>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
        {
            <span>No reviews found for "@ViewBag.SearchString".</span>
        }
        else
        {
            <span>No reviews have been posted yet.</span>
        }
    </div>
}
else
{
    <p class="text-muted mb-2">@Model.Count() review(s) found.</p>

    @foreach (var review in Model)
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <a asp-controller="Events" asp-action="PublicDetails" asp-route-id="@review.EventId">
                        @review.Event?.EventName
                    </a>
                </h3>
                <span class="event-category">@review.Event?.Category?.CategoryName</span>
            </div>

            <p class="event-meta">
                <strong>@review.Member?.FullName</strong> &middot;
                <span class="text-muted">@review.ReviewDate.ToString("dd MMM yyyy")</span>
            </p>

            <p class="event-meta">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= review.Rating)
                    {
                        <span style="color: #f59e0b; font-size: 1.2rem;">&#9733;</span>
                    }
                    else
                    {
                        <span style="color: #cbd5e1; font-size: 1.2rem;">&#9733;</span>
                    }
                }
                <span class="text-muted">(@review.Rating / 5)</span>
            </p>

            @if (!string.IsNullOrEmpty(review.Comment))
            {
                <p>@review.Comment</p>
            }
        </div>
    }
}
