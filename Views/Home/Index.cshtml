@model IEnumerable<SmartEventTicketing.Models.Event>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero">
    <h1>Welcome to the Cultural Events Hub</h1>
    <p>
        Discover and book tickets to the best concerts, plays, exhibitions, and workshops
        across the metropolitan area. Curated by the Metropolitan Cultural Council to bring
        the city's vibrant arts scene closer to you.
    </p>
    <div class="hero-actions">
        <a asp-controller="Events" asp-action="Browse" class="btn btn-primary">Browse All Events</a>
        @if (!User.Identity!.IsAuthenticated)
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline">Become a Member</a>
        }
    </div>
</section>

<!-- About the Council -->
<section class="card mt-3">
    <div class="card-header">
        <h2 class="card-title">About the Council</h2>
    </div>
    <p>
        The Metropolitan Cultural Council promotes and supports cultural activities across the
        city. We work with local artists, performers, and organisations to deliver a diverse
        calendar of events that celebrate creativity, heritage, and community.
    </p>
    <p class="text-muted mb-1">
        Members enjoy priority booking, exclusive previews, and personalised event recommendations
        based on their interests. Guests can browse upcoming events and read reviews from the
        community.
    </p>
</section>

<!-- Upcoming Events -->
<section class="mt-3">
    <div class="section-heading">
        <h2>Upcoming Events</h2>
        <a asp-controller="Events" asp-action="Browse" class="btn btn-outline btn-sm">View All</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No upcoming events at the moment. Please check back soon.
        </div>
    }
    else
    {
        <div class="event-grid">
            @foreach (var item in Model)
            {
                <article class="event-card">
                    <div class="event-card-image">
                        @item.EventName
                    </div>
                    <div class="event-card-body">
                        <span class="event-category">@item.Category?.CategoryName</span>
                        <h3 class="event-name">@item.EventName</h3>
                        <p class="event-meta"><strong>Venue:</strong> @item.Venue</p>
                        <p class="event-meta"><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy, h:mm tt")</p>
                        <p class="event-meta">
                            @if (item.AvailableSeats > 0)
                            {
                                <span class="availability-tag availability-available">Available</span>
                            }
                            else
                            {
                                <span class="availability-tag availability-full">Full</span>
                            }
                        </p>
                        <p class="event-price">From LKR @item.StandardPrice.ToString("N2")</p>
                    </div>
                    <div class="event-card-footer">
                        <a asp-controller="Events" asp-action="PublicDetails" asp-route-id="@item.EventId" class="btn btn-primary btn-sm">View Details</a>
                    </div>
                </article>
            }
        </div>
    }
</section>
