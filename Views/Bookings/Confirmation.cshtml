@model SmartEventTicketing.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="alert alert-success">
    <strong>Booking confirmed!</strong> Your tickets have been reserved. A reference is shown below.
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">@Model.Event?.EventName</h2>
        <span class="event-category">@Model.Event?.Category?.CategoryName</span>
    </div>

    <p class="event-meta"><strong>Booking Reference:</strong> #BK-@Model.BookingId.ToString("D6")</p>
    <p class="event-meta"><strong>Booked By:</strong> @Model.Member?.FullName</p>
    <p class="event-meta"><strong>Booking Date:</strong> @Model.BookingDate.ToString("dd MMM yyyy, h:mm tt")</p>

    <hr style="margin: 1rem 0; border: none; border-top: 1px solid #e2e8f0;" />

    <p class="event-meta"><strong>Venue:</strong> @Model.Event?.Venue</p>
    <p class="event-meta"><strong>Event Date:</strong> @Model.Event?.EventDate.ToString("dddd, dd MMMM yyyy, h:mm tt")</p>
    <p class="event-meta"><strong>Seat Type:</strong> @Model.SeatType</p>
    <p class="event-meta"><strong>Quantity:</strong> @Model.Quantity ticket(s)</p>
    <p class="event-meta"><strong>Payment Status:</strong> <span class="text-success">@Model.PaymentStatus</span></p>
    <p class="event-price" style="font-size: 1.3rem;">Total Paid: LKR @Model.TotalAmount.ToString("N2")</p>

    <div class="action-buttons mt-2">
        <a asp-action="MyBookings" class="btn btn-primary">View My Bookings</a>
        <a asp-controller="Events" asp-action="Browse" class="btn btn-outline">Browse More Events</a>
    </div>
</div>
