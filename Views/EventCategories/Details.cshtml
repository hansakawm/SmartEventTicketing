@model SmartEventTicketing.Models.EventCategory

@{
    ViewData["Title"] = "Category Details";
}

<h2>Category Details</h2>

<div class="card mt-2">
    <p><strong>Category Name:</strong> @Model.CategoryName</p>

    <div class="action-buttons mt-2">
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-outline">Back to List</a>
    </div>
</div>
