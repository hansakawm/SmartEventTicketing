@model IEnumerable<SmartEventTicketing.Models.EventCategory>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="section-heading">
    <h2>Manage Categories</h2>
    <a asp-action="Create" class="btn btn-success">+ Add New Category</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No categories yet.</div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CategoryName</td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-secondary btn-sm">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-outline btn-sm">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
